# ======================
# Core Node Configuration
# ======================

# Discovery service (the one we just built)
DISCOVERY_URL=https://your-discovery-service.onrender.com

# Shared secret (must match the discovery service)
NETWORK_SECRET=change-this-to-a-long-random-string

# Network identity
NETWORK_ID=mainnet
APP_VERSION=0.2.0

# This node's public URL (important when deployed)
# Leave empty for local development (will auto-detect or use localhost)
PUBLIC_URL=

# Local ports
HTTP_PORT=8332
P2P_PORT=8333

# Mining
MINING_ENABLED=true
DIFFICULTY=4
BLOCK_REWARD=50
BLOCK_TIME_TARGET=30

# Data directory
DATA_DIR=./data
