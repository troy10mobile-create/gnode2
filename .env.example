# ======================
# Core Node Configuration
# ======================

# Discovery service
DISCOVERY_URL=https://your-discovery-service.onrender.com

# Shared secret (must match the discovery service)
NETWORK_SECRET=change-this-to-a-long-random-string

# Network identity
NETWORK_ID=mainnet
APP_VERSION=0.3.0

# This node's public URL (important when deployed)
# Leave empty on Render: the node automatically uses RENDER_EXTERNAL_URL.
PUBLIC_URL=

# Local ports
HTTP_PORT=8332
P2P_PORT=8333

# Mining / Monetary policy
MINING_ENABLED=true
DIFFICULTY=4
INITIAL_BLOCK_REWARD=50
REWARD_REDUCTION_INTERVAL=1000000
REWARD_REDUCTION_FACTOR=0.9
BLOCK_TIME_TARGET=120

# Pruning (every Nth block)
PRUNE_INTERVAL=10

# Data directory
DATA_DIR=./data
